# Copy to .env and fill in. Never commit the real .env file.

# Agent 0: export this Azure resource group as the migration source instead
# of passing a .bicep file on the command line.
AZURE_RESOURCE_GROUP=
AZURE_SUBSCRIPTION_ID=

# AWS Bedrock + CloudFormation
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
MAX_FIX_ATTEMPTS=2

# Guardrail security scan (checkov + custom secret/IAM/network checks) before deployment
GUARDRAIL_SCAN_ENABLED=true

# RAG retrieval over knowledge_base docs for Agent 3's prompt
RAG_ENABLED=true
RAG_TOP_K=4
RAG_HYBRID_SEARCH=true
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# Optional: LangSmith tracing/evaluation (off unless both vars below are set)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=bicep-to-cfn-migration
LANGSMITH_ENDPOINT=

# Optional: where Agent 3's system prompt is loaded from ("local" or "hub")
PROMPT_SOURCE=local
